{
  "name": "nazar-review",
  "version": "1.0.0",
  "description": "Free AI code review for every Indian developer. GitHub Action + CLI, powered by BharatCode.",
  "license": "MIT",
  "type": "module",
  "author": "Ankit Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ironankit525/nazar.git"
  },
  "homepage": "https://github.com/Ironankit525/nazar#readme",
  "bugs": "https://github.com/Ironankit525/nazar/issues",
  "keywords": [
    "code-review",
    "ai",
    "github-action",
    "bharatcode",
    "llm",
    "secrets",
    "cli",
    "india"
  ],
  "bin": {
    "nazar": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "all": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "commander": "^15.0.0",
    "jsonrepair": "^3.15.0",
    "minimatch": "^11.0.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
